<Window x:Class="LyricNow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricNow"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <Window.Resources>
        <Style x:Key="TinyButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root">
        <Border.ContextMenu>
            <ContextMenu Opened="OnMenuOpened">
                <MenuItem x:Name="StyleMenu" Header="Style" />
                <MenuItem Header="Lyrics timing">
                    <MenuItem Header="Show lyrics sooner (+0.5 s)" Click="OnAdvanceLyrics" />
                    <MenuItem Header="Show lyrics later (−0.5 s)" Click="OnDelayLyrics" />
                    <MenuItem Header="Reset timing for this song" Click="OnResetTiming" />
                </MenuItem>
                <MenuItem x:Name="GeniusItem"
                          Header="Also search Genius for lyrics"
                          IsCheckable="True"
                          Click="OnToggleGenius" />
                <Separator />
                <MenuItem x:Name="AutostartItem"
                          Header="Start hidden with Windows (show when Spotify opens)"
                          IsCheckable="True"
                          Click="OnToggleAutostart" />
                <MenuItem Header="Reset position" Click="OnResetPosition" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExit" />
            </ContextMenu>
        </Border.ContextMenu>

        <!-- Column 0 only holds the Strip look's dot; it collapses to nothing otherwise. -->
        <Grid x:Name="Layout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel x:Name="HeaderRow" Grid.Row="0" Grid.ColumnSpan="2">
                <Border x:Name="Cover"
                        DockPanel.Dock="Left"
                        Width="34" Height="34"
                        Margin="0,0,10,0"
                        CornerRadius="7" />
                <TextBlock x:Name="TrackText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <TextBlock x:Name="PrevLine" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" />

            <Ellipse x:Name="Dot"
                     Grid.Row="2" Grid.RowSpan="2" Grid.Column="0"
                     Width="8" Height="8"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center" />

            <TextBlock x:Name="CurrentLine"
                       Grid.Row="2" Grid.Column="1"
                       Margin="0,4,0,4"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Text="Starting…" />

            <TextBlock x:Name="NextLine" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />

            <Border x:Name="ProgressTrack" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" />
            </Border>

            <DockPanel x:Name="FooterRow" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,0" LastChildFill="True">
                <!-- Only visible while hovering, so it stays out of the way. -->
                <StackPanel x:Name="TimingPanel" DockPanel.Dock="Left" Orientation="Horizontal" Opacity="0">
                    <Button Style="{StaticResource TinyButton}" Content="−" Click="OnDelayLyrics"
                            ToolTip="Lyrics are ahead of the music: show them later" />
                    <Button Style="{StaticResource TinyButton}" Content="+" Click="OnAdvanceLyrics"
                            ToolTip="Lyrics are behind the music: show them sooner" />
                    <TextBlock x:Name="OffsetText" VerticalAlignment="Center" FontSize="10" Foreground="#99FFFFFF" />
                </StackPanel>

                <TextBlock x:Name="SourceText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="9"
                           Foreground="#55FFFFFF" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
