<Window x:Class="LyricNow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricNow"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <Window.Resources>
        <Style x:Key="TinyButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#D9121418" Padding="16,12,16,10">
        <Border.ContextMenu>
            <ContextMenu Opened="OnMenuOpened">
                <MenuItem x:Name="AutostartItem"
                          Header="Start hidden with Windows (show when Spotify opens)"
                          IsCheckable="True"
                          Click="OnToggleAutostart" />
                <MenuItem Header="Reset timing for this song" Click="OnResetTiming" />
                <MenuItem Header="Reset position" Click="OnResetPosition" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExit" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <TextBlock x:Name="TrackText"
                       FontSize="11"
                       Foreground="#99FFFFFF"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="PrevLine"
                       Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="#88FFFFFF"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="CurrentLine"
                       Margin="0,4,0,4"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Text="Starting…" />

            <TextBlock x:Name="NextLine"
                       FontSize="13"
                       Foreground="#88FFFFFF"
                       TextWrapping="Wrap" />

            <DockPanel Margin="0,6,0,0" LastChildFill="True">
                <!-- Only visible while hovering, so it stays out of the way. -->
                <StackPanel x:Name="TimingPanel" DockPanel.Dock="Left" Orientation="Horizontal" Opacity="0">
                    <Button Style="{StaticResource TinyButton}" Content="−" Click="OnDelayLyrics"
                            ToolTip="Lyrics are ahead of the music: show them later" />
                    <Button Style="{StaticResource TinyButton}" Content="+" Click="OnAdvanceLyrics"
                            ToolTip="Lyrics are behind the music: show them sooner" />
                    <TextBlock x:Name="OffsetText" VerticalAlignment="Center" FontSize="10" Foreground="#99FFFFFF" />
                </StackPanel>

                <TextBlock x:Name="SourceText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="9"
                           Foreground="#55FFFFFF" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
